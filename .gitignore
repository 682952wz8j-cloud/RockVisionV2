.DS_Store
__MACOSX/
._*
.idea/

# Xcode / macOS user state
xcuserdata/
DerivedData/
*.xcuserstate

# Incoming captures and Terra/DJI/iPhone derivatives. Keep docs only.
incoming/**
!incoming/README.md
!incoming/**/
!incoming/**/README.md
!incoming/**/.gitkeep
!incoming/**/metadata/NOTES.txt

# Generated offline products. Rebuild from incoming + tools.
offline/work/**
!offline/work/README.md

# Generated Wall Package binaries (schema JSON may be committed later)
walls/**/localization/*.bin
walls/**/visual/

# OpenCV rebuild trees and the XCFramework binary (rebuild from pin files)
ios/Vendor/OpenCV/build/
ios/Vendor/OpenCV/opencv/
ios/Vendor/OpenCV/opencv_contrib/
ios/Vendor/OpenCV/opencv2.xcframework/

# Mac OpenCV 4.14.0 CLI/Python binding built from the same pinned source
offline/vendor/opencv414/

# Gate 3C development fixture binaries. Commit the manifest only.
ios/RockVision/Resources/DevelopmentFixture/descriptors.bin
ios/RockVision/Resources/DevelopmentFixture/landmarks.json

# Field Test exports if copied from an iPhone into this repo
**/FieldTests/
gate3b_*.json
gate3b_*.jsonl

# Python
.venv/
offline/.venv/
backend/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# Local secrets (never commit SecretId / SecretKey / keys)
.env
*.env
!.env.example
!backend/.env.example
cos.env
credentials
*.pem
*.p12
*.key
id_rsa
id_ed25519
*_rsa
