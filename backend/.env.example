# CragPal Cloud Asset API — environment variable NAMES only.
# Copy to backend/.env locally. Never commit real SecretId / SecretKey.

TENCENT_COS_REGION=ap-guangzhou
TENCENT_SECRET_ID=replace-with-secret-id
TENCENT_SECRET_KEY=replace-with-secret-key
TENCENT_COS_BUCKET=example-private-bucket-1250000000

# Optional. Default is COS-backed published catalog.
# Use memory only for local contract tests; never for production publishing.
# CRAGPAL_ASSET_STORE=memory
